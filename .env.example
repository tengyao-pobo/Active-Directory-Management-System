# Values are placeholders. Use the deployment secret store, never commit .env.
ConnectionStrings__Console=Host=<database-dns>;Database=<database>;Username=<runtime-role>;Password=<secret>;SSL Mode=VerifyFull
Console__Origin=https://<console-dns>
Console__RelyingPartyId=<console-dns>
AllowedHosts=<console-dns>
Console__WindowsAuthentication=true
Console__EmergencyLogin=true
Console__EmergencyAllowedAddresses__0=<approved-management-workstation-ip>
