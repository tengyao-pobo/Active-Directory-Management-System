<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Server\Api\Api.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\Persistence\Persistence.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\AgentEnrollment\AgentEnrollment.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\EnrollmentGrantExecution\EnrollmentGrantExecution.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\EnrollmentGrantDelivery\EnrollmentGrantDelivery.csproj" />
    <ProjectReference Include="..\..\src\Server\ConnectorHost\ConnectorHost.csproj" />
    <ProjectReference Include="..\..\src\Server\Provisioning\Provisioning.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\build\provision-runtime.sql" Link="provision-runtime.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\audit-enrollment-grant-operations.sql" Link="audit-enrollment-grant-operations.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\enrollment-execution-functions.sql" Link="enrollment-execution-functions.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\enrollment-execution-profile.sql" Link="enrollment-execution-profile.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\provision-enrollment-execution.sql" Link="provision-enrollment-execution.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\audit-enrollment-execution.sql" Link="audit-enrollment-execution.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\audit-enrollment-delivery.sql" Link="audit-enrollment-delivery.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\audit-enrollment-delivery-catalog.sql" Link="audit-enrollment-delivery-catalog.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\enrollment-delivery-profile.sql" Link="enrollment-delivery-profile.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\enrollment-delivery-identity.sql" Link="enrollment-delivery-identity.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\audit-enrollment-delivery-identity.sql" Link="audit-enrollment-delivery-identity.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\audit-enrollment-delivery-bindings.sql" Link="audit-enrollment-delivery-bindings.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\provision-enrollment-delivery.sql" Link="provision-enrollment-delivery.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\upgrade-enrollment-execution-v3-to-v4.sql" Link="upgrade-enrollment-execution-v3-to-v4.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\enrollment-execution-queue.sql" Link="enrollment-execution-queue.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\upgrade-enrollment-execution-v2-to-v3.sql" Link="upgrade-enrollment-execution-v2-to-v3.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\enrollment-execution\v2\*.sql" Link="enrollment-execution/v2/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\build\enrollment-execution\v3\*.sql" Link="enrollment-execution/v3/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
